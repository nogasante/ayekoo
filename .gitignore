# Model weights — never commit these to git
model/*.gguf
model/*.bin
model/*.safetensors

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Local profiler output
submission.json
audit.json

# Corpus source PDFs — refetchable from corpus/sources.yaml, too large to commit.
# The extracted text in corpus/text/ IS committed: it is the actual corpus, and
# the submission must work offline without refetching anything.
corpus/raw/

# Build logs
index-build.log
*.log

# The retrieval index IS committed (index/chunks.jsonl, vectors.npy,
# manifest.json) — the submission must work offline without re-embedding the
# corpus, which takes ~15 minutes of CPU.
