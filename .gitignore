# ==============================================================================
# Ayekoo - .gitignore
# ==============================================================================

# ── Model Weights ─────────────────────────────────────────────────────────────
# Model weights must be fetched via download_model.sh and never committed to git
model/*.gguf
model/*.bin
model/*.safetensors
model/*.pt
model/*.onnx
*.partial

# ── Python Artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Logs & Debug Output ───────────────────────────────────────────────────────
*.log
*.log.*
server.log
fetch.log
index-build.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Corpus Raw Downloads ──────────────────────────────────────────────────────
# Raw PDFs are too large to commit (~100 MB); refetchable via corpus/sources.yaml.
# Note: corpus/text/ IS committed so the submission runs 100% offline out-of-the-box.
corpus/raw/

# ── Operating System & Editors ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
scratch/

# ── Note on Submissions & Index ───────────────────────────────────────────────
# The pre-computed index (index/chunks.jsonl, index/vectors.npy, index/manifest.json)
# and submission specs (metadata.json, submission.json) are committed for offline evaluation.

# ── Internal Competition Audit & Intelligence Files ───────────────────────────
# Internal research and audit artifacts kept local only
competitors.csv
COMPETITOR_ANALYSIS.md
AYEKOO_VS_COMPETITORS.md
CURRENT_SCORE_ANALYSIS.md
COMPETITION_RULES.md
FINAL_COMPETITION_BRIEF.md
SUBMISSION_AUDIT.md
EVALUATION_REPORT.md
ARCHITECTURE.md
evaluation/

